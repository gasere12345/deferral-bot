TELEGRAM_TOKEN=your_token_here
DATABASE_PATH=bot/deferral.db
# Порт health-check сервера. На Render подставляется автоматически — задавать НЕ нужно
# PORT=8080
# Чаты, куда слать уведомления (ежедневные/еженедельные) через запятую
NOTIFICATION_CHAT_ID=
# Разрешённые chat/user id через запятую. Пусто = бот доступен всем
ALLOWED_IDS=
# За сколько дней напоминать о предстоящем платеже
REMINDER_DAYS=3
# Облачная SQLite (Turso). Если заданы оба — база хранится в Turso, а не на диске Render
TURSO_URL=
TURSO_AUTH_TOKEN=
